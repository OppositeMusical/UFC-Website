{
  "name": "ufc-predictor-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Electron shell for the MMA Assist local Flask app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ufcpredictor.desktop",
    "productName": "MMA Assist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/UFCPredictor",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "certificateFile": "certs/code-signing.pfx",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    }
  }
}
