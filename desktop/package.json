{
  "name": "ufc-predictor-desktop",
  "version": "0.3.2",
  "private": true,
  "description": "Electron shell for the MMA Assist local Flask app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ufcpredictor.desktop",
    "productName": "MMA Assist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/UFCPredictor",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "certificateFile": "certs/code-signing.pfx",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "../macos/entitlements.mac.plist",
      "entitlementsInherit": "../macos/entitlements.mac.plist",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "MMA Assist ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
