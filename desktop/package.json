{
  "name": "ufc-predictor-desktop",
  "version": "0.6.2",
  "private": true,
  "description": "Electron shell for the MMA Assist local Flask app",
  "author": "OppositeMusical",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ufcpredictor.desktop",
    "productName": "MMA Assist",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/UFCPredictor",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "certificateFile": "certs/code-signing.pfx",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OppositeMusical",
        "repo": "UFC-Website",
        "publisherName": [
          "OppositeMusical"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "../macos/entitlements.mac.plist",
      "entitlementsInherit": "../macos/entitlements.mac.plist",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "MMA Assist ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
